# All six hostnames must point to this Linode before enabling this configuration.
# Preserve any unrelated site blocks already on the server.
seven-coffee.com {
    root * /srv/seven/current
    encode zstd gzip
    file_server
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
}

www.seven-coffee.com, seven-belfast.co.uk, www.seven-belfast.co.uk, sevencoffee.co.uk, www.sevencoffee.co.uk {
    redir https://seven-coffee.com{uri} permanent
}
